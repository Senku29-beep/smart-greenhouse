/*
  ======================================================================
  ТЕСТ СЕРВОПРИВОДА (ДЛЯ ФОРТОЧКИ)
  ======================================================================
  
  НАЗНАЧЕНИЕ:
  Проверить работоспособность сервопривода и определить
  правильные углы для открытия/закрытия форточки.
  
  ПОДКЛЮЧЕНИЕ:
  - Коричневый/чёрный (GND) → GND Arduino
  - Красный (VCC) → 5V Arduino (только для маленьких серво!)
  - Оранжевый/жёлтый (SIG) → Pin 4 Arduino
  
  ВАЖНО:
  - Для мощных серво (MG995) нужно ВНЕШНЕЕ питание 5-6В/2А!
  - При питании от Arduino возможны просадки напряжения
  
  ПРИНЦИП РАБОТЫ:
  Серво последовательно проходит 3 теста:
  1. Плавное движение от 0° до 180°
  2. Пошаговое движение (0° → 90° → 180° → 90° → 0°)
  3. Удержание в крайних положениях
  ======================================================================
*/

#include <Servo.h>

Servo myServo;  // Создаём объект для управления серво

#define SERVO_PIN 4   // Пин управления
#define SERVO_MIN 0   // Минимальный угол (закрыто)
#define SERVO_MAX 90  // Максимальный угол (открыто)

void setup() {
  Serial.begin(9600);
  Serial.println(F("========================================"));
  Serial.println(F("ТЕСТ СЕРВОПРИВОДА"));
  Serial.println(F("========================================"));
  
  // Привязываем серво к пину
  myServo.attach(SERVO_PIN);
  Serial.print(F("Серво подключен к пину "));
  Serial.println(SERVO_PIN);
  
  Serial.println(F("\n=== ТЕСТ 1: ПЛАВНОЕ ДВИЖЕНИЕ ==="));
  smoothMovement();
  
  delay(1000);
  
  Serial.println(F("\n=== ТЕСТ 2: ПОШАГОВОЕ ДВИЖЕНИЕ ==="));
  stepMovement();
  
  delay(1000);
  
  Serial.println(F("\n=== ТЕСТ 3: УДЕРЖАНИЕ ПОЗИЦИИ ==="));
  holdPosition();
  
  Serial.println(F("\n========================================"));
  Serial.println(F("ТЕСТ ЗАВЕРШЁН"));
  Serial.println(F("Если серво не двигался — проверьте питание!"));
  Serial.println(F("========================================"));
}

void loop() {
  // После завершения тестов можно добавить повторяющееся движение
  // Раскомментируйте для непрерывного теста:
  
  // Serial.println(F("Повторяющееся движение: 0° → 90° → 0°"));
  // myServo.write(0);
  // delay(2000);
  // myServo.write(90);
  // delay(2000);
}

// ======================================================================
// ФУНКЦИЯ 1: ПЛАВНОЕ ДВИЖЕНИЕ
// ======================================================================
void smoothMovement() {
  Serial.println(F("Плавное движение от 0° до 180°..."));
  
  // Плавно увеличиваем угол
  for (int angle = 0; angle <= 180; angle++) {
    myServo.write(angle);
    delay(10);  // 10 мс между шагами = плавное движение
  }
  
  delay(500);
  
  Serial.println(F("Плавное движение от 180° до 0°..."));
  
  // Плавно уменьшаем угол
  for (int angle = 180; angle >= 0; angle--) {
    myServo.write(angle);
    delay(10);
  }
  
  delay(500);
  Serial.println(F("[OK] Плавное движение завершено"));
}

// ======================================================================
// ФУНКЦИЯ 2: ПОШАГОВОЕ ДВИЖЕНИЕ
// ======================================================================
void stepMovement() {
  // 0° (закрыто)
  Serial.println(F("Угол 0° (закрыто)"));
  myServo.write(0);
  delay(2000);
  
  // 90° (среднее положение)
  Serial.println(F("Угол 90° (среднее)"));
  myServo.write(90);
  delay(2000);
  
  // 180° (открыто)
  Serial.println(F("Угол 180° (открыто)"));
  myServo.write(180);
  delay(2000);
  
  // Обратно
  Serial.println(F("Угол 90° (среднее)"));
  myServo.write(90);
  delay(2000);
  
  Serial.println(F("Угол 0° (закрыто)"));
  myServo.write(0);
  delay(2000);
  
  Serial.println(F("[OK] Пошаговое движение завершено"));
}

// ======================================================================
// ФУНКЦИЯ 3: УДЕРЖАНИЕ ПОЗИЦИИ
// ======================================================================
void holdPosition() {
  Serial.println(F("Удержание в положении 0° в течение 3 секунд..."));
  myServo.write(0);
  delay(3000);
  
  Serial.println(F("Удержание в положении 90° в течение 3 секунд..."));
  myServo.write(90);
  delay(3000);
  
  Serial.println(F("Удержание в положении 180° в течение 3 секунд..."));
  myServo.write(180);
  delay(3000);
  
  Serial.println(F("[OK] Удержание позиции завершено"));
}
