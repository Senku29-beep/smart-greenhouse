// ФУНКЦИЯ 1: ПОИСК ДИСПЛЕЯ НА ШИНЕ I2C
// Назначение: найти дисплей на шине I2C по известным адресам (0x27, 0x3F)
// Алгоритм: перебирает все адреса из массива POSSIBLE_LCD_ADDRESSES
// Для каждого адреса пробует установить соединение через Wire.beginTransmission()
// Если устройство ответило (error == 0) - дисплей найден
// Возвращает: true если дисплей найден, false если не найден
bool discoverLCD() {
  // Выводим сообщение в Serial монитор о начале поиска
  Serial.println("Поиск дисплея на шине I2C...");
  
  // Цикл for для перебора всех возможных адресов дисплея
  // i = счётчик цикла, начинается с 0, увеличивается на 1 каждый раз
  // i < NUM_POSSIBLE_ADDRESSES (2) - цикл выполнится 2 раза: для i=0 и i=1
  for (int i = 0; i < NUM_POSSIBLE_ADDRESSES; i++) {
    
    // Берем очередной адрес из массива POSSIBLE_LCD_ADDRESSES
    // POSSIBLE_LCD_ADDRESSES[0] = 0x27, POSSIBLE_LCD_ADDRESSES[1] = 0x3F
    uint8_t address = POSSIBLE_LCD_ADDRESSES[i];
    
    // Выводим информацию о проверяемом адресе в Serial монитор
    Serial.print("Пробую адрес 0x");
    Serial.print(address, HEX);  // HEX - выводим в шестнадцатеричном формате
    Serial.print("... ");
    
    // Wire.beginTransmission(address) - начинаем передачу на указанный адрес
    // I2C шина: мастер (Arduino) обращается к ведомому с адресом address
    Wire.beginTransmission(address);
    
    // Wire.endTransmission() - завершаем передачу и получаем код ошибки
    // error = 0: успешно (устройство ответило)
    // error = 1: данные слишком длинные для буфера
    // error = 2: адрес не получен (NACK на адресе)
    // error = 3: данные не получены (NACK на данных)
    // error = 4: другая ошибка
    byte error = Wire.endTransmission();
    
    // Проверяем, есть ли ошибка (error == 0 значит успех)
    if (error == 0) {
      // Если ошибки нет (код 0) - дисплей найден!
      Serial.println("НАШЕЛ!");
      
      // Сохраняем найденный адрес в переменную lcdAddress
      lcdAddress = address;
      
      // Возвращаем true (успех) из функции
      return true;
      
    } else {
      // Если есть ошибка - на этом адресе никого нет
      Serial.println("нет ответа");
    }
    
    // Делаем короткую паузу 10 мс между попытками, чтобы не перегружать шину I2C
    delay(10);
  }
  
  // Если дошли до этой точки - ни на одном адресе не нашли дисплей
  Serial.println("Дисплей не найден на шине I2C");
  
  // Возвращаем false (неудача) из функции
  return false;
}

// ФУНКЦИЯ 2: ИНИЦИАЛИЗАЦИЯ ДИСПЛЕЯ
// Назначение: создать и настроить объект дисплея
// Шаги:
//   1. Если объект уже существует - удалить его (освободить память)
//   2. Найти дисплей на шине I2C (вызов discoverLCD)
//   3. Создать новый объект дисплея с найденным адресом
//   4. Инициализировать дисплей (lcd->init())
//   5. Включить подсветку (lcd->backlight())
//   6. Показать тестовое сообщение
// Возвращает: true если инициализация успешна, false если нет
bool initializeLCD() {
  // ШАГ 1: Проверяем, существует ли уже объект дисплея
  // lcd != NULL - указатель не равен NULL (то есть указывает на существующий объект)
  if (lcd != NULL) {
    // Если объект существует (указатель не равен NULL)
    // Удаляем старый объект из памяти с помощью оператора delete
    // delete освобождает память, выделенную оператором new
    delete lcd;
    
    // Устанавливаем указатель в NULL (теперь он ничего не указывает)
    lcd = NULL;
    
    // Ждем 100 мс чтобы память полностью освободилась
    delay(100);
  }
  
  // ШАГ 2: Пытаемся найти дисплей на шине I2C
  // !discoverLCD() означает "НЕ discoverLCD()" (true если discoverLCD вернул false)
  if (!discoverLCD()) {
    // Если не нашли дисплей (!discoverLCD() = true)
    // Возвращаем false - инициализация не удалась
    return false;
  }
  
  // ШАГ 3: Создаем новый объект дисплея
  // Оператор new выделяет память и создает объект класса LiquidCrystal_I2C
  // Параметры конструктора: адрес дисплея (lcdAddress), 16 столбцов, 2 строки
  lcd = new LiquidCrystal_I2C(lcdAddress, 16, 2);
  
  // ШАГ 4: Настраиваем дисплей
  // lcd->init() - вызываем метод init() у объекта дисплея для инициализации
  // Стрелка -> используется потому что lcd - это указатель, а не сам объект
  lcd->init();
  
  // Ждем 100 мс пока дисплей инициализируется (нужно для стабильности)
  delay(100);
  
  // Включаем подсветку дисплея с помощью метода backlight()
  lcd->backlight();
  
  // Ждем 50 мс после включения подсветки
  delay(50);
  
  // ШАГ 5: Показываем тестовое сообщение
  // Очищаем экран дисплея с помощью метода clear()
  lcd->clear();
  
  // Устанавливаем курсор в позицию: столбец 0, строка 0
  // setCursor(колонка, строка) - колонка от 0 до 15, строка от 0 до 1
  lcd->setCursor(0, 0);
  
  // Печатаем текст "LCD Found!" (только английские буквы!)
  // Русские буквы не поддерживаются в большинстве LCD дисплеев
  lcd->print("LCD Found!");
  
  // Переходим на вторую строку: столбец 0, строка 1
  lcd->setCursor(0, 1);
  
  // Печатаем текст "Addr: 0x"
  lcd->print("Addr: 0x");
  
  // Печатаем адрес дисплея в шестнадцатеричном формате
  lcd->print(lcdAddress, HEX);
  
  // Показываем сообщение 1 секунду (1000 мс)
  delay(1000);
  
  // Выводим информацию в Serial монитор
  Serial.print("Дисплей инициализирован на адресе 0x");
  Serial.println(lcdAddress, HEX);
  
  // Возвращаем true - инициализация успешна
  return true;
}

// ФУНКЦИЯ 3: ПРОВЕРКА ЗДОРОВЬЯ ДИСПЛЕЯ
// Назначение: проверить, отвечает ли дисплей на команды
// Метод проверки: выключаем и включаем отображение (не подсветку)
// Если дисплей завис, эти команды могут не выполниться
// Возвращает: true если дисплей здоров, false если нет
bool checkLCDHealth() {
  // Проверяем, существует ли объект дисплея (указатель не равен NULL)
  if (lcd == NULL) {
    // Если объекта нет - возвращаем false (дисплей не инициализирован)
    return false;
  }
  
  // Проверяем, включена ли супер-защита (макрос SUPER_PROTECTION)
  #if SUPER_PROTECTION
  // Если супер-защита включена (SUPER_PROTECTION = true)
  
  // Пытаемся выполнить простую операцию с дисплеем
  // lcd->noDisplay() - выключаем отображение (текст пропадает, но подсветка остаётся)
  lcd->noDisplay();
  
  // Ждем 10 мс
  delay(10);
  
  // lcd->display() - включаем отображение обратно
  lcd->display();
  
  // Ждем 10 мс
  delay(10);
  
  // Если выполнение дошло до этой точки без зависания - дисплей работает
  // Обновляем время последней успешной работы
  lastDisplaySuccess = millis();
  
  // Возвращаем true - дисплей здоров
  return true;
  
  #else
  // Если защита отключена (SUPER_PROTECTION = false)
  // Всегда считаем что дисплей работает (упрощённый режим)
  return true;
  #endif
}

// ФУНКЦИЯ 4: БЕЗОПАСНАЯ ПЕЧАТЬ НА ДИСПЛЕЙ
// Назначение: напечатать текст на дисплее безопасным способом
// Проверяет, что:
//   1. Объект дисплея существует (lcd != NULL)
//   2. Дисплей в нормальном режиме (currentDisplayMode == DISPLAY_NORMAL)
// Параметры:
//   text - текст для печати (только английский!)
//   col - столбец (0-15)
//   row - строка (0-1)
// Возвращает: true если печать успешна, false если нет
bool safePrint(const char* text, uint8_t col, uint8_t row) {
  // ПРОВЕРКА 1: Существует ли объект дисплея?
  if (lcd == NULL) {
    // Нет объекта - не можем печатать, возвращаем false
    return false;
  }
  
  // ПРОВЕРКА 2: Дисплей в нормальном режиме?
  if (currentDisplayMode != DISPLAY_NORMAL) {
    // Дисплей не в нормальном режиме - не печатаем, возвращаем false
    return false;
  }
  
  // Проверяем, включена ли супер-защита
  #if SUPER_PROTECTION
  // Если супер-защита включена
  
  // Устанавливаем курсор в указанную позицию
  lcd->setCursor(col, row);
  
  // Печатаем текст
  lcd->print(text);
  
  // Обновляем время последней успешной работы
  lastDisplaySuccess = millis();
  
  // Возвращаем true - успешно напечатали
  return true;
  
  #else
  // Если защита отключена - печатаем без проверок
  lcd->setCursor(col, row);
  lcd->print(text);
  return true;
  #endif
}

// ФУНКЦИЯ 5: ПОПЫТКА ВОССТАНОВЛЕНИЯ ДИСПЛЕЯ
// Назначение: попытаться восстановить работу дисплея после сбоя
// Использует 3 метода (по возрастанию сложности):
//   1. Мягкий сброс (выключить/включить подсветку)
//   2. Переинициализация (удалить объект и создать заново)
//   3. Полный сброс I2C шины (Wire.end() + Wire.begin())
// Возвращает: true если восстановление успешно, false если нет
bool attemptDisplayRecovery() {
  // Получаем текущее время в миллисекундах с помощью функции millis()
  unsigned long currentTime = millis();
  
  // Проверяем, можно ли пытаться восстановить сейчас
  // Если разница между текущим временем и временем последней попытки меньше RECOVERY_INTERVAL (5 сек)
  // - ещё рано пытаться (не спамим попытками)
  if (currentTime - lastRecoveryAttempt < RECOVERY_INTERVAL) {
    // Возвращаем false - ещё рано пытаться
    return false;
  }
  
  // Начинаем попытку восстановления
  Serial.println("Пытаюсь восстановить дисплей...");
  
  // Запоминаем время этой попытки
  lastRecoveryAttempt = currentTime;
  
  // Увеличиваем счетчик попыток на 1
  displayRecoveryAttempts++;
  
  // ===== МЕТОД 1: МЯГКИЙ СБРОС (самый простой) =====
  // Проверяем, существует ли объект дисплея
  if (lcd != NULL) {
    Serial.println("Метод 1: Мягкий сброс");
    
    // Выключаем подсветку дисплея (но сам дисплей остаётся включённым)
    lcd->noBacklight();
    
    // Ждем 200 мс
    delay(200);
    
    // Включаем подсветку обратно
    lcd->backlight();
    
    // Ждем 200 мс
    delay(200);
    
    // Проверяем, помогло ли (дисплей отвечает на команды?)
    if (checkLCDHealth()) {
      // Если помогло - вызываем функцию успешного восстановления
      recoverySuccess();
      
      // Возвращаем true - восстановление успешно
      return true;
    }
  }
  
  // ===== МЕТОД 2: ПЕРЕИНИЦИАЛИЗАЦИЯ (создаём объект заново) =====
  Serial.println("Метод 2: Переинициализация");
  
  // Пробуем создать дисплей заново с помощью функции initializeLCD()
  // initializeLCD() сама удалит старый объект и создаст новый
  if (initializeLCD()) {
    // Проверяем, работает ли теперь дисплей
    if (checkLCDHealth()) {
      // Если работает - вызываем функцию успешного восстановления
      recoverySuccess();
      
      // Возвращаем true - восстановление успешно
      return true;
    }
  }
  
  // ===== МЕТОД 3: ПОЛНЫЙ СБРОС I2C ШИНЫ =====
  // Делаем только после 3-х неудачных попыток (чтобы не сбрасывать шину слишком часто)
  if (displayRecoveryAttempts >= 3) {
    Serial.println("Метод 3: Полный сброс I2C шины");
    
    // Wire.end() - отключаем всю шину I2C
    // Освобождает пины SDA и SCL, останавливает I2C периферию
    Wire.end();
    
    // Ждем 100 мс
    delay(100);
    
    // Wire.begin() - включаем шину I2C заново
    // Инициализирует I2C периферию с частотой 100 кГц
    Wire.begin();
    
    // Ждем 100 мс
    delay(100);
    
    // Пробуем инициализировать дисплей после сброса шины
    // && означает "И" - оба условия должны быть true
    if (initializeLCD() && checkLCDHealth()) {
      // Если работает - вызываем функцию успешного восстановления
      recoverySuccess();
      
      // Возвращаем true - восстановление успешно
      return true;
    }
  }
  
  // Если сделали 10 попыток и все неудачные
  if (displayRecoveryAttempts >= MAX_RECOVERY_ATTEMPTS) {
    Serial.println("Слишком много неудачных попыток. Сдаюсь.");
    
    // Переходим в режим "отключен" - больше не пытаемся
    currentDisplayMode = DISPLAY_DISCONNECTED;
  }
  
  // Возвращаем false - восстановление не удалось
  return false;
}

// ФУНКЦИЯ 6: ОБРАБОТКА УСПЕШНОГО ВОССТАНОВЛЕНИЯ
// Назначение: выполнить действия после успешного восстановления дисплея
// Обнуляет счётчик попыток, переключает дисплей в нормальный режим,
// показывает сообщение о восстановлении на 1.5 секунды
void recoverySuccess() {
  // Выводим сообщение в Serial монитор
  Serial.println("Дисплей успешно восстановлен!");
  
  // Сбрасываем счетчик попыток восстановления в 0
  displayRecoveryAttempts = 0;
  
  // Переходим в нормальный режим
  currentDisplayMode = DISPLAY_NORMAL;
  
  // Обновляем время последней успешной работы
  lastDisplaySuccess = millis();
  
  // Возвращаемся к первому экрану (0)
  displayScreen = 0;
  
  // Сбрасываем таймер смены экрана (чтобы сразу не переключился)
  lastDisplayChange = millis();
  
  // Показываем сообщение о восстановлении на дисплее
  lcd->clear();
  lcd->setCursor(0, 0);
  lcd->print("Recovered!");     // "Восстановлено!"
  lcd->setCursor(0, 1);
  lcd->print("Resuming...");    // "Продолжаю..."
  
  // Показываем сообщение 1.5 секунды (1500 мс)
  delay(1500);
}


// =====================================================================
// РАЗДЕЛ 10: ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ (ФИЛЬТРЫ, УСРЕДНЕНИЕ)
// =====================================================================

// ФУНКЦИЯ 7: ФИЛЬТР СГЛАЖИВАНИЯ ЗНАЧЕНИЙ (экспоненциальное сглаживание)
// Назначение: убирает резкие скачки в показаниях датчиков
// Применяется ко всем датчикам (температура, влажность, почва, свет)
// Формула: новое = старое * (1 - коэффициент) + новое_сырое * коэффициент
// При коэффициенте 0.3: 70% от старого значения + 30% от нового
// Пример: было 50, пришло 100 → результат = 50*0.7 + 100*0.3 = 35+30 = 65
// Параметры:
//   oldValue - предыдущее отфильтрованное значение (float)
//   newValue - новое "сырое" значение с датчика (float)
//   coeff - коэффициент фильтрации (0.0 - 1.0)
// Возвращает: новое отфильтрованное значение
float applyFilter(float oldValue, float newValue, float coeff) {
  // Формула экспоненциального сглаживания
  // oldValue * (1 - coeff) - берём (1-коэффициент)% от старого значения
  // newValue * coeff - берём коэффициент% от нового значения
  // Складываем и возвращаем результат
  return oldValue * (1 - coeff) + newValue * coeff;
}

// ФУНКЦИЯ 8: ТОЧНОЕ ИЗМЕРЕНИЕ ВЛАЖНОСТИ ПОЧВЫ (с усреднением)
// Назначение: получаем стабильные показания датчика почвы
// Проблема: датчик почвы даёт неточные значения из-за помех
// Решение: делаем 10 измерений, сортируем, исключаем выбросы, берём среднее
// Алгоритм:
//   1. Делаем 10 измерений и сохраняем в массив
//   2. Сортируем массив по возрастанию (пузырьковая сортировка)
//   3. Отбрасываем 2 самых маленьких и 2 самых больших (убираем выбросы)
//   4. Берём среднее арифметическое оставшихся 6 значений
// Возвращает: усреднённое "сырое" значение (0-1023)
int readSoilMoistureStable() {
  // Проверяем, включен ли датчик влажности почвы в настройках
  #if ENABLE_SOIL  // Если ENABLE_SOIL = true
  
  const int NUM_READINGS = 10;  // Количество измерений для усреднения
  int readings[NUM_READINGS];   // Массив для хранения измерений (10 элементов)
  
  // Цикл для сбора измерений с датчика
  // i = 0; i < NUM_READINGS; i++ - повторяем NUM_READINGS раз
  for (int i = 0; i < NUM_READINGS; i++) {
    // analogRead(SOIL_MOISTURE_PIN) - читаем значение с аналогового пина A0
    readings[i] = analogRead(SOIL_MOISTURE_PIN);
    delay(2);  // Короткая пауза 2 мс для стабилизации датчика
  }
  
  // СОРТИРОВКА измерений по возрастанию (пузырьковая сортировка)
  // Это нужно чтобы исключить выбросы (очень большие или очень маленькие значения)
  // Внешний цикл: проходим по всем элементам массива
  for (int i = 0; i < NUM_READINGS - 1; i++) {
    // Внутренний цикл: сравниваем текущий элемент со всеми следующими
    for (int j = i + 1; j < NUM_READINGS; j++) {
      // Если текущий элемент больше следующего (неправильный порядок)
      if (readings[i] > readings[j]) {
        // Меняем элементы местами
        int temp = readings[i];      // Сохраняем текущий элемент во временную переменную
        readings[i] = readings[j];   // Записываем на место текущего меньший элемент
        readings[j] = temp;          // Записываем на место следующего больший элемент
      }
    }
  }
  
  // Суммируем средние значения, исключая 2 самых маленьких и 2 самых больших
  // Это убирает возможные выбросы (ошибки измерений)
  int sum = 0;  // Переменная для хранения суммы
  // Начинаем с индекса 2 (третий элемент), заканчиваем NUM_READINGS-2 (предпоследний элемент)
  // Так пропускаем readings[0] и readings[1] (2 минимальных)
  // и readings[8] и readings[9] (2 максимальных)
  for (int i = 2; i < NUM_READINGS - 2; i++) {
    sum += readings[i];  // Добавляем значение к сумме
  }
  
  // Возвращаем среднее значение (сумма / количество)
  // NUM_READINGS - 4 = 10 - 4 = 6 (столько значений мы просуммировали)
  return sum / (NUM_READINGS - 4);
  
  #else  // Если ENABLE_SOIL = false (датчик отключен)
  
  // Возвращаем среднее значение 512 (середина диапазона 0-1023)
  // Это тестовое значение для проверки логики без датчика
  return 512;
  
  #endif
}

// ФУНКЦИЯ 9: ЧТЕНИЕ АНАЛОГОВОГО ДАТЧИКА С УСРЕДНЕНИЕМ
// Назначение: универсальная функция для любого аналогового датчика
// Применяется для датчика освещённости (фоторезистор)
// Параметр: pin - номер аналогового пина для чтения
// Возвращает: усреднённое значение (0-1023)
int readAnalogSensorStable(int pin) {
  const int NUM_READINGS = 10;  // Количество измерений
  int readings[NUM_READINGS];   // Массив для хранения
  
  // Собираем измерения с указанного пина
  for (int i = 0; i < NUM_READINGS; i++) {
    readings[i] = analogRead(pin);  // Читаем значение с указанного пина
    delay(2);  // Короткая пауза
  }
  
  // СОРТИРОВКА измерений по возрастанию (пузырьковая сортировка)
  for (int i = 0; i < NUM_READINGS - 1; i++) {
    for (int j = i + 1; j < NUM_READINGS; j++) {
      if (readings[i] > readings[j]) {
        int temp = readings[i];
        readings[i] = readings[j];
        readings[j] = temp;
      }
    }
  }
  
  // Суммируем средние значения (исключаем крайние - по 2 с каждого конца)
  int sum = 0;
  for (int i = 2; i < NUM_READINGS - 2; i++) {
    sum += readings[i];
  }
  
  // Возвращаем среднее арифметическое
  return sum / (NUM_READINGS - 4);
}


// =====================================================================
// РАЗДЕЛ 11: ФУНКЦИЯ НАЧАЛЬНОЙ НАСТРОЙКИ (SETUP)
// =====================================================================
// Функция setup() выполняется ОДИН РАЗ при включении или перезагрузке Arduino
// Здесь мы настраиваем:
//   - Пины (какие работают на вход, какие на выход)
//   - Дисплей (поиск адреса, инициализация)
//   - Датчики (DHT11, датчик воды)
//   - Исполнительные устройства (насос, фитолента, сервопривод)
//   - Таймеры (переменные для отсчёта времени)
//
// ВАЖНО: RELAY_INVERTED = false (реле ОБЫЧНОЕ)
// Это означает: HIGH (5В) = ВКЛЮЧЕНО, LOW (0В) = ВЫКЛЮЧЕНО
// =====================================================================

void setup() {

  // -------------------------------------------------------------------
  // БЛОК 1: НАСТРОЙКА ПИТАНИЯ НАСОСА (в самом начале, для безопасности)
  // -------------------------------------------------------------------
  // Важно: сразу после включения Arduino все пины находятся в неопределённом состоянии
  // Поэтому мы принудительно устанавливаем НАСОС в ВЫКЛЮЧЕННОЕ состояние
  // Это предотвращает случайное включение насоса при старте
  
  // pinMode(PUMP_PIN, OUTPUT) - настраиваем пин 3 как выход
  // OUTPUT означает, что Arduino может подавать на этот пин напряжение (5В) или 0В
  pinMode(PUMP_PIN, OUTPUT);
  
  // digitalWrite(PUMP_PIN, LOW) - устанавливаем на пине 3 НИЗКИЙ уровень (0В)
  // RELAY_INVERTED = false, поэтому LOW = ВЫКЛЮЧЕНО
  // Насос НЕ будет работать сразу после включения
  digitalWrite(PUMP_PIN, LOW);      // Насос выключен (безопасное состояние)


  // -------------------------------------------------------------------
  // БЛОК 2: ДЛИННАЯ ПАУЗА ДЛЯ СТАБИЛИЗАЦИИ ПИТАНИЯ
  // -------------------------------------------------------------------
  // После подачи питания многие устройства (дисплей, датчики) требуют времени на "пробуждение"
  // Если начать работу с ними сразу — могут быть ошибки или зависания
  // 3000 миллисекунд = 3 секунды
  delay(3000);
  
  
  // -------------------------------------------------------------------
  // БЛОК 3: НАСТРОЙКА ПОСЛЕДОВАТЕЛЬНОГО ПОРТА (USB-СВЯЗЬ С КОМПЬЮТЕРОМ)
  // -------------------------------------------------------------------
  // Serial.begin(9600) - открывает порт со скоростью 9600 бит/сек
  // Скорость должна совпадать со скоростью в мониторе порта Arduino IDE
  // Через USB-кабель можно выводить отладочную информацию на компьютер
  Serial.begin(9600);
  
  // Выводим приветственное сообщение
  Serial.println("=== SMART GREENHOUSE STARTED ===");
  Serial.println("System initialization...");
  
  
  // -------------------------------------------------------------------
  // БЛОК 4: НАСТРОЙКА ШИНЫ I2C (ДЛЯ СВЯЗИ С ДИСПЛЕЕМ)
  // -------------------------------------------------------------------
  // Wire.begin() - инициализирует библиотеку Wire для работы с шиной I2C
  // I2C нужен для связи с LCD дисплеем (всего 2 провода: SDA и SCL)
  // На Arduino Uno: SDA на пине A4, SCL на пине A5
  Wire.begin();
  
  // Ждём 100 мс для стабилизации шины I2C
  delay(100);
  
  
  // -------------------------------------------------------------------
  // БЛОК 5: НАСТРОЙКА ВСТРОЕННОГО СВЕТОДИОДА (ДЛЯ ИНДИКАЦИИ)
  // -------------------------------------------------------------------
  // pinMode(STATUS_LED, OUTPUT) - настраиваем пин 13 как выход
  // На этом пине физически находится светодиод на плате Arduino
  pinMode(STATUS_LED, OUTPUT);
  
  // digitalWrite(STATUS_LED, LOW) - выключаем светодиод (0В)
  digitalWrite(STATUS_LED, LOW);
  
  // Мигаем светодиодом 3 раза для проверки, что Arduino жив и работает
  // for - цикл, выполняется 3 раза (i = 0, 1, 2)
  for (int i = 0; i < 3; i++) {
    digitalWrite(STATUS_LED, HIGH);   // Включаем (5В)
    delay(200);                       // Ждём 200 мс (0.2 секунды)
    digitalWrite(STATUS_LED, LOW);    // Выключаем (0В)
    delay(200);                       // Ждём 200 мс
  }
  
  
  // -------------------------------------------------------------------
  // БЛОК 6: ПОИСК И НАСТРОЙКА LCD ДИСПЛЕЯ
  // -------------------------------------------------------------------
  Serial.println("\nИщу дисплей...");
  
  // initializeLCD() - функция, которая:
  //   1. Ищет дисплей на шине I2C (проверяет адреса 0x27 и 0x3F)
  //   2. Создаёт объект дисплея
  //   3. Инициализирует дисплей (включает подсветку, очищает экран)
  // Возвращает true если успешно, false если не найден
  if (initializeLCD()) {
    // Если дисплей найден и настроен — переходим в нормальный режим
    currentDisplayMode = DISPLAY_NORMAL;
    Serial.println("Дисплей найден и настроен");
  } else {
    // Если дисплей не найден — будем пытаться восстановить в основном цикле loop()
    currentDisplayMode = DISPLAY_RECOVERING;
    Serial.println("Дисплей не найден, буду пытаться в основном цикле");
  }
  
  
  // -------------------------------------------------------------------
  // БЛОК 7: НАСТРОЙКА ДАТЧИКА ТЕМПЕРАТУРЫ И ВЛАЖНОСТИ DHT11
  // -------------------------------------------------------------------
  // dht.begin() - инициализация датчика DHT11
  // Устанавливает пин DHT_PIN (пин 2) как вход
  // Отправляет стартовый сигнал датчику
  dht.begin();
  
  
  // -------------------------------------------------------------------
  // БЛОК 8: НАСТРОЙКА ПИНОВ ДЛЯ ИСПОЛНИТЕЛЬНЫХ УСТРОЙСТВ
  // -------------------------------------------------------------------
  // pinMode(пин, OUTPUT) - настраивает пин как выход
  // Arduino будет подавать напряжение на эти пины для управления устройствами
  
  pinMode(PUMP_PIN, OUTPUT);        // Пин насоса (3) как выход
  pinMode(LED_GROW_PIN, OUTPUT);    // Пин фитоленты (5) как выход
  
  
  // -------------------------------------------------------------------
  // БЛОК 9: НАСТРОЙКА ПИНОВ ДАТЧИКА ВОДЫ (С ИМПУЛЬСНЫМ ПИТАНИЕМ)
  // -------------------------------------------------------------------
  // Датчик воды HCW-M203 подключается к 12В через реле
  // Реле управляется с пина 8, включая питание датчика только на время измерения
  
  // pinMode(WATER_SENSOR_PIN, INPUT_PULLUP) - сигнальный пин как вход
  // INPUT_PULLUP включает внутренний подтягивающий резистор (к 5В через 20-50 кОм)
  // Это нужно чтобы пин не "висел" в воздухе (имел определённое состояние)
  pinMode(WATER_SENSOR_PIN, INPUT_PULLUP);
  
  // pinMode(WATER_SENSOR_RELAY_PIN, OUTPUT) - пин реле датчика воды как выход
  pinMode(WATER_SENSOR_RELAY_PIN, OUTPUT);
  
  // digitalWrite(WATER_SENSOR_RELAY_PIN, HIGH) - устанавливаем HIGH (5В)
  // RELAY_INVERTED = false, но реле датчика воды может работать по-своему
  // HIGH = реле ВЫКЛЮЧЕНО (безопасное начальное состояние)
  digitalWrite(WATER_SENSOR_RELAY_PIN, HIGH);
  
  
  // -------------------------------------------------------------------
  // БЛОК 10: УСТАНОВКА НАЧАЛЬНОГО СОСТОЯНИЯ УСТРОЙСТВ (ВСЕ ВЫКЛЮЧЕНЫ)
  // -------------------------------------------------------------------
  // При запуске все исполнительные устройства должны быть ВЫКЛЮЧЕНЫ
  // Это безопасное состояние — ничего не работает без команды
  
  // ---- НАСОС ----
  // RELAY_INVERTED = false, поэтому LOW = ВЫКЛЮЧЕНО
  digitalWrite(PUMP_PIN, LOW);      // Насос выключен
  
  // ---- ФИТОЛЕНТА ----
  // RELAY_INVERTED = false, поэтому LOW = ВЫКЛЮЧЕНО
  digitalWrite(LED_GROW_PIN, LOW);  // Фитолента выключена
  
  
  // -------------------------------------------------------------------
  // БЛОК 11: НАСТРОЙКА СЕРВОПРИВОДА (ФОРТОЧКА)
  // -------------------------------------------------------------------
  // ventServo.attach(SERVO_PIN) - привязываем объект серво к пину 4
  // attach() инициализирует таймер для генерации PWM сигнала (широтно-импульсной модуляции)
  // PWM позволяет задавать угол поворота сервопривода
  ventServo.attach(SERVO_PIN);
  
  // ventServo.write(SERVO_CLOSED) - устанавливаем угол 0° (закрыто)
  // SERVO_CLOSED = 0 (константа из раздела 7)
  ventServo.write(SERVO_CLOSED);
  
  // delay(500) - ждём 500 миллисекунд (0.5 секунды)
  // Сервоприводу нужно время, чтобы физически повернуться на заданный угол
  delay(500);
  
  
  // -------------------------------------------------------------------
  // БЛОК 12: ВЫВОД ИНФОРМАЦИИ О НАСТРОЙКАХ В SERIAL МОНИТОР
  // -------------------------------------------------------------------
  Serial.println("\n=== SYSTEM SETTINGS ===");
  
  Serial.print("Water plants when soil < ");
  Serial.print(SOIL_DRY);
  Serial.println("%");
  
  Serial.print("Open window when temperature > ");
  Serial.print(OPEN_TEMP);
  Serial.println("C");
  
  Serial.print("Turn on grow light when light < ");
  Serial.print(LIGHT_ON_THRESHOLD);
  Serial.println("%");
  
  
  // -------------------------------------------------------------------
  // БЛОК 13: ТЕСТИРОВАНИЕ РЕЛЕ ФИТОЛЕНТЫ (ДЛЯ ПРОВЕРКИ ПОДКЛЮЧЕНИЯ)
  // -------------------------------------------------------------------
  Serial.println("\nTesting grow light relay...");
  
  // ВКЛЮЧАЕМ фитоленту на 1 секунду (для проверки)
  // RELAY_INVERTED = false, поэтому HIGH = ВКЛ
  digitalWrite(LED_GROW_PIN, HIGH);
  delay(1000);                      // Держим включенной 1 секунду
  
  // ВЫКЛЮЧАЕМ фитоленту
  digitalWrite(LED_GROW_PIN, LOW);
  delay(1000);
  
  
  // -------------------------------------------------------------------
  // БЛОК 14: ВЫВОД СТАТУСА ДАТЧИКОВ (ЧТО ВКЛЮЧЕНО, ЧТО ОТКЛЮЧЕНО)
  // -------------------------------------------------------------------
  Serial.println("\n=== SENSOR STATUS ===");
  
  #if ENABLE_DHT
  Serial.println("DHT11 temperature/humidity sensor: ENABLED");
  #endif
  
  #if ENABLE_SOIL
  Serial.println("Soil moisture sensor: ENABLED");
  #endif
  
  #if ENABLE_LIGHT
  Serial.println("Light sensor: ENABLED");
  #endif
  
  #if ENABLE_WATER
  Serial.println("Water level sensor: ENABLED");
  #endif
  
  
  // -------------------------------------------------------------------
  // БЛОК 15: ПРИВЕТСТВЕННОЕ СООБЩЕНИЕ НА ДИСПЛЕЕ
  // -------------------------------------------------------------------
  // Проверяем, находится ли дисплей в нормальном режиме
  if (currentDisplayMode == DISPLAY_NORMAL) {
    // Очищаем экран дисплея
    lcd->clear();
    
    // Устанавливаем курсор в начало первой строки (столбец 0, строка 0)
    lcd->setCursor(0, 0);
    
    // Печатаем название системы (только английские буквы!)
    lcd->print("Smart Greenhouse");
    
    // Переходим на вторую строку (столбец 0, строка 1)
    lcd->setCursor(0, 1);
    
    // Печатаем статус
    lcd->print("System Ready");
    
    // Показываем сообщение 2 секунды
    delay(2000);
  }
  
  
  // -------------------------------------------------------------------
  // БЛОК 16: ИНИЦИАЛИЗАЦИЯ ТАЙМЕРОВ (ВРЕМЕННЫХ ПЕРЕМЕННЫХ)
  // -------------------------------------------------------------------
  // Запоминаем текущее время для смены экранов дисплея
  lastDisplayChange = millis();
  
  // Запоминаем время успешной работы дисплея (для авто-восстановления)
  lastDisplaySuccess = millis();
  
  // Инициализируем время последнего полива
  // millis() - возвращает количество миллисекунд с момента включения Arduino
  // Устанавливаем lastWatering = текущее время, чтобы насос не начал поливать сразу при старте
  lastWatering = millis();
  
  
  // -------------------------------------------------------------------
  // БЛОК 17: ФИНАЛЬНЫЕ СООБЩЕНИЯ
  // -------------------------------------------------------------------
  Serial.println("\n=== SYSTEM READY ===");
  
  // Пауза 2 секунды для чтения сообщений в мониторе порта
  delay(2000);
  
  // Очищаем экран перед началом основной работы
  if (currentDisplayMode == DISPLAY_NORMAL) {
    lcd->clear();
  }
  
} // КОНЕЦ ФУНКЦИИ setup()


// =====================================================================
// ПОЯСНЕНИЕ РАБОТЫ ПЕРЕМЕННОЙ lastWatering
// =====================================================================
/*
  lastWatering хранит время последнего ОКОНЧАНИЯ полива в миллисекундах.
  
  Почему это важно:
  - При старте Arduino lastWatering = millis() (текущее время)
  - Если millis() вернула 5000 (5 секунд после включения), то lastWatering = 5000
  - Для включения насоса нужно: currentTime - lastWatering > WATERING_COOLDOWN
  - WATERING_COOLDOWN = 600000 (10 минут = 600 000 миллисекунд)
  - Значит, насос включится только когда currentTime - 5000 > 600000
  - То есть когда currentTime > 605000 (через 10 минут и 5 секунд после старта)
  
  Это гарантирует, что насос НЕ включится сразу после подачи питания,
  а подождёт как минимум 10 минут (или дольше, если почва влажная).
*/


// =====================================================================
// РАЗДЕЛ 12: ЧТЕНИЕ ВСЕХ ДАТЧИКОВ (С ЗАЩИТАМИ И ФИЛЬТРАЦИЕЙ)
// =====================================================================

// Функция для чтения всех датчиков
void readSensors() {
  
  // ===== 1. ДАТЧИК DHT11 (ТЕМПЕРАТУРА И ВЛАЖНОСТЬ ВОЗДУХА) =====
  #if ENABLE_DHT
  // Статическая переменная для хранения времени последнего чтения
  // static - сохраняет значение между вызовами функции (не обнуляется каждый раз)
  static unsigned long lastDHTReadTime = 0;
  
  // Получаем текущее время в миллисекундах
  unsigned long currentTime = millis();
  
  // ВАЖНО: DHT11 требует минимум 2 СЕКУНДЫ между чтениями!
  // Если читать чаще - он будет возвращать старые значения или ошибку
  const unsigned long DHT_MIN_INTERVAL = 2000;  // 2000 мс = 2 секунды
  
  // Проверяем, прошло ли достаточно времени с последнего чтения
  if (currentTime - lastDHTReadTime >= DHT_MIN_INTERVAL) {
    // Обновляем время последнего чтения
    lastDHTReadTime = currentTime;
    
    // ЧИТАЕМ ДАТЧИК
    // dht.readTemperature() - возвращает температуру в градусах Цельсия
    // Если датчик не отвечает, возвращает NaN (Not a Number)
    float tempRaw = dht.readTemperature();
    
    // dht.readHumidity() - возвращает влажность в процентах
    float humidityRaw = dht.readHumidity();
    
    // ПРОВЕРЯЕМ НА ОШИБКИ
    // isnan() - проверяет, является ли значение NaN
    if (isnan(tempRaw) || isnan(humidityRaw)) {
      // Если ошибка чтения (датчик не ответил)
      Serial.println("DHT11: READ ERROR - Sensor not responding!");
      
      // Увеличиваем счетчик ошибок
      dhtErrorCount++;
      
      // Если ошибок слишком много (больше MAX_DHT_ERRORS)
      if (dhtErrorCount > MAX_DHT_ERRORS) {
        Serial.println("DHT11: Too many errors! Sensor may be dead.");
      }
      
      // Не обновляем фильтрованные значения при ошибке
      // Просто выходим из блока (не применяем фильтрацию)
      // return не делаем, продолжаем чтение других датчиков
    } else {
      // ДАТЧИК ВЕРНУЛ КОРРЕКТНЫЕ ЗНАЧЕНИЯ
      
      // ВЫВОД СЫРЫХ ЗНАЧЕНИЙ ДЛЯ ДИАГНОСТИКИ
      Serial.print("DHT11: RAW - Temp=");
      Serial.print(tempRaw);
      Serial.print("C, Humidity=");
      Serial.print(humidityRaw);
      Serial.println("%");
      
      // ПРОВЕРКА НА ЗАЛИПАНИЕ (DHT11 иногда залипает на одном значении)
      // Статические переменные для хранения предыдущих значений
      static float prevTemp = 25.0;
      static float prevHumidity = 60.0;
      static int sameValueCount = 0;
      
      // Проверяем, изменились ли значения (с учётом погрешности 0.1)
      float tempDelta = abs(tempRaw - prevTemp);
      float humidityDelta = abs(humidityRaw - prevHumidity);
      
      if (tempDelta < 0.1 && humidityDelta < 0.1) {
        // Значения почти не изменились (залипание)
        sameValueCount++;
        Serial.print("DHT11: Values not changing! Count=");
        Serial.println(sameValueCount);
        
        // Если значения не менялись 5 раз подряд (15 секунд)
        if (sameValueCount >= 5) {
          Serial.println("DHT11: HARD RESET ATTEMPT...");
          
          // Жёсткий сброс: создаём новый объект датчика
          // В Arduino нельзя просто удалить объект, но можно заново инициализировать
          dht.begin();  // Переинициализация
          delay(100);
          dht.begin();  // Двойная переинициализация для уверенности
          delay(2000);   // Ждём 2 секунды после сброса
          
          // Сбрасываем счётчик
          sameValueCount = 0;
          
          // Не обновляем значения после сброса (подождём следующего цикла)
          return;  // Выходим из функции readSensors(), но не из loop()
        }
      } else {
        // Значения изменились - датчик работает нормально
        if (sameValueCount > 0) {
          Serial.println("DHT11: Values changed - sensor OK");
          sameValueCount = 0;
        }
        
        // Сохраняем текущие значения для следующего сравнения
        prevTemp = tempRaw;
        prevHumidity = humidityRaw;
        
        // Сбрасываем счётчик ошибок
        dhtErrorCount = 0;
        
        // ПРИМЕНЯЕМ ФИЛЬТРАЦИЮ
        // applyFilter(старое, новое, коэффициент)
        // коэффициент 0.3 = 70% старого + 30% нового
        tempFiltered = applyFilter(tempFiltered, tempRaw, FILTER_COEFF);
        humidityFiltered = applyFilter(humidityFiltered, humidityRaw, FILTER_COEFF);
        
        // ВЫВОД ОТФИЛЬТРОВАННЫХ ЗНАЧЕНИЙ
        Serial.print("DHT11: FILTERED - Temp=");
        Serial.print(tempFiltered);
        Serial.print("C, Humidity=");
        Serial.print(humidityFiltered);
        Serial.println("%");
      }
    }
  } else {
    // Ещё не прошло 2 секунды - пропускаем чтение (это нормально)
    // Выводим сообщение раз в 10 секунд (чтобы не засорять монитор порта)
    static unsigned long lastSkipMessage = 0;
    if (currentTime - lastSkipMessage > 10000) {
      lastSkipMessage = currentTime;
      Serial.println("DHT11: Waiting 2 seconds between readings...");
    }
  }
  #endif  // Конец блока #if ENABLE_DHT
  
  
  // 2. ЧТЕНИЕ ВЛАЖНОСТИ ПОЧВЫ
  #if ENABLE_SOIL
    // Получаем стабильное значение датчика почвы (0-1023)
    int soilRaw = readSoilMoistureStable();
  
    // ПРЕОБРАЗОВАНИЕ В ПРОЦЕНТЫ
    // ВАЖНО: первое число должно быть МЕНЬШЕ второго!
    // У вас: мокрая (233) < сухая (554) → правильно
    int soilPercent = map(soilRaw, SOIL_DRY_CALIB, SOIL_WET_CALIB, 0, 100);
    //                           мокрая(233)     сухая(554)      0%    100%
  
    // Ограничиваем значение между 0 и 100%
    soilPercent = constrain(soilPercent, 0, 100);
  
    // Применяем фильтр сглаживания
    soilMoistureFiltered = (int)applyFilter((float)soilMoistureFiltered, (float)soilPercent, FILTER_COEFF * 0.5);
  
    // ОТЛАДКА (удалите после проверки)
    static unsigned long lastDebug = 0;
    if (millis() - lastDebug > 5000) {
      lastDebug = millis();
      Serial.print("SOIL: raw=");
      Serial.print(soilRaw);
      Serial.print(" → percent=");
      Serial.print(soilPercent);
      Serial.print(" → filtered=");
      Serial.println(soilMoistureFiltered);
    }
  #endif
  
  
  // ===== 3. ДАТЧИК ОСВЕЩЁННОСТИ (ФОТОРЕЗИСТОР) =====
  #if ENABLE_LIGHT
  // Получаем усреднённое значение датчика освещённости
  int lightRaw = readAnalogSensorStable(LIGHT_SENSOR_PIN);
  
  // Преобразуем в проценты (инвертированное преобразование)
  // Ваш датчик инвертированный: темно → большое значение (0), светло → маленькое (675)
  // Поэтому преобразуем: темно (0) → 100%, светло (675) → 0%
  int lightPercent = map(lightRaw, DARK_VALUE, BRIGHT_VALUE, 100, 0);
  
  // Ограничиваем значение 0-100%
  lightPercent = constrain(lightPercent, 0, 100);
  
  // Применяем фильтр сглаживания
  lightLevelFiltered = (int)applyFilter((float)lightLevelFiltered, (float)lightPercent, FILTER_COEFF);
  
  // Отладочный вывод
  static unsigned long lastLightDebug = 0;
  if (millis() - lastLightDebug > 60000) {  // Раз в минуту
    lastLightDebug = millis();
    Serial.print("LIGHT: raw=");
    Serial.print(lightRaw);
    Serial.print(" percent=");
    Serial.print(lightPercent);
    Serial.print(" filtered=");
    Serial.println(lightLevelFiltered);
  }
  #else
  // Если датчик освещённости отключен - тестовое значение 50%
  lightLevelFiltered = 50;
  #endif
  
  
  // ===== 4. ДАТЧИК УРОВНЯ ВОДЫ (ИМПУЛЬСНОЕ ПИТАНИЕ ЧЕРЕЗ РЕЛЕ) =====
  #if ENABLE_WATER
    // Статические переменные для хранения состояния между вызовами
    static bool pinConfigured = false;     // Настроены ли пины?
    static unsigned long lastWaterReadTime = 0;  // Время последнего измерения
    
    // Настраиваем пины (только один раз)
    if (!pinConfigured) {
      pinMode(WATER_SENSOR_PIN, INPUT);           // Сигнальный пин как вход
      pinMode(WATER_SENSOR_RELAY_PIN, OUTPUT);    // Пин реле как выход
      digitalWrite(WATER_SENSOR_RELAY_PIN, HIGH);  // HIGH = реле выключено (нет питания)
      pinConfigured = true;
    }
    
    unsigned long currentMillis = millis();
    
    // Проверяем, прошло ли 10 секунд с последнего измерения
    if (currentMillis - lastWaterReadTime >= 10000) {
      lastWaterReadTime = currentMillis;
      
      // ВКЛЮЧАЕМ питание датчика через реле
      // RELAY_INVERTED = true, значит LOW = ВКЛ
      digitalWrite(WATER_SENSOR_RELAY_PIN, LOW);   // ВКЛЮЧИЛИ питание 12В
      
      // Ждём стабилизации датчика (50 мс - достаточно для HCW-M203)
      delay(50);
      
      // Читаем состояние датчика
      // digitalRead() возвращает HIGH (1) или LOW (0)
      bool currentReading = (digitalRead(WATER_SENSOR_PIN) == HIGH);
      
      // ВЫКЛЮЧАЕМ питание датчика (чтобы не было электролиза)
      digitalWrite(WATER_SENSOR_RELAY_PIN, HIGH);  // ВЫКЛЮЧИЛИ питание
      
      // --- Защита от дребезга (стабилизация состояния) ---
      // Дребезг - когда датчик быстро меняет состояние из-за колебаний воды
      static unsigned long lastStableTime = 0;
      static bool lastStableState = false;
      static bool previousRawReading = false;
      
      // Если состояние изменилось
      if (currentReading != previousRawReading) {
        lastStableTime = currentMillis;
        previousRawReading = currentReading;
      }
      
      // Если состояние стабильно в течение 2 секунд
      if (currentMillis - lastStableTime > 2000) {
        if (lastStableState != currentReading) {
          lastStableState = currentReading;
          waterPresent = currentReading;
          Serial.print("WATER: Tank changed to ");
          Serial.println(waterPresent ? "FULL" : "EMPTY");
        }
      } else {
        // Пока состояние не стабилизировалось, используем последнее стабильное
        waterPresent = lastStableState;
      }
      
      // Отладочный вывод (раз в 10 измерений = 100 секунд)
      static int debugCounter = 0;
      debugCounter++;
      if (debugCounter >= 10) {
        debugCounter = 0;
        Serial.print("WATER: waterPresent = ");
        Serial.println(waterPresent ? "FULL" : "EMPTY");
        Serial.print("Raw reading: ");
        Serial.println(currentReading ? "HIGH" : "LOW");
      }
    }
    
  #else
    // Если датчик воды отключен - считаем что вода есть (для нормальной работы полива)
    waterPresent = true;
  #endif
}


// =====================================================================
// РАЗДЕЛ 13: УПРАВЛЕНИЕ ВЕНТИЛЯЦИЕЙ (ФОРТОЧКОЙ)
// =====================================================================

// Функция для управления форточкой на основе температуры
// Принцип работы: гистерезис с порогами OPEN_TEMP (28°C) и CLOSE_TEMP (26°C)
void controlWindow(float temperature) {
  // Проверка на ошибку датчика температуры
  // isnan() проверяет, является ли значение "не числом" (NaN)
  if (isnan(temperature)) {
    // Если температура некорректна - выводим сообщение об ошибке
    Serial.println("ERROR: Temperature sensor returned invalid value");
    // Выходим из функции (не выполняем дальнейший код)
    return;
  }
  
  // УСЛОВИЕ 1: ОТКРЫТЬ ФОРТОЧКУ
  // Проверяем, не пора ли открыть форточку:
  // 1. Температура >= порога открытия (28°C)
  // 2. Форточка сейчас закрыта (!windowIsOpen означает "НЕ открыта")
  if (temperature >= OPEN_TEMP && !windowIsOpen) {
    // Даём команду сервоприводу повернуться на угол SERVO_OPEN (90°)
    ventServo.write(SERVO_OPEN);
    
    // Ждём 500 мс, чтобы сервопривод успел повернуться
    delay(500);
    
    // Запоминаем текущий угол (для информации)
    ventAngle = SERVO_OPEN;
    
    // Запоминаем, что форточка теперь открыта (чтобы не посылать команду снова)
    windowIsOpen = true;
    
    // Выводим сообщение в Serial монитор
    Serial.print("VENTILATION: Opening window at ");
    Serial.print(temperature);
    Serial.println("C (too hot)");
    
    // Показываем сообщение на дисплее
    if (currentDisplayMode == DISPLAY_NORMAL) {
      lcd->clear();
      safePrint("TEMPERATURE HIGH", 0, 0);
      safePrint("OPENING WINDOW", 0, 1);
      delay(1000);
    }
  }
  
  // УСЛОВИЕ 2: ЗАКРЫТЬ ФОРТОЧКУ
  // Проверяем, не пора ли закрыть форточку:
  // 1. Температура <= порога закрытия (26°C)
  // 2. Форточка сейчас открыта
  else if (temperature <= CLOSE_TEMP && windowIsOpen) {
    // Даём команду сервоприводу повернуться на угол SERVO_CLOSED (0°)
    ventServo.write(SERVO_CLOSED);
    
    // Ждём 500 мс
    delay(500);
    
    // Запоминаем текущий угол
    ventAngle = SERVO_CLOSED;
    
    // Запоминаем, что форточка теперь закрыта
    windowIsOpen = false;
    
    // Выводим сообщение
    Serial.print("VENTILATION: Closing window at ");
    Serial.print(temperature);
    Serial.println("C (normal temp)");
    
    // Показываем сообщение на дисплее
    if (currentDisplayMode == DISPLAY_NORMAL) {
      lcd->clear();
      safePrint("TEMPERATURE OK", 0, 0);
      safePrint("CLOSING WINDOW", 0, 1);
      delay(1000);
    }
  }
  
  // Если температура между 26°C и 28°C - ничего не делаем
  // Форточка остаётся в текущем положении
  // Это гистерезис, предотвращает "дребезг" при температуре около порога
}


// =====================================================================
// РАЗДЕЛ 14: УПРАВЛЕНИЕ ВСЕМИ СИСТЕМАМИ ТЕПЛИЦЫ
// =====================================================================
// В этом разделе принимаются решения о включении/выключении:
// - Полива (насос)
// - Освещения (фитолента)
// - Вентиляции (форточка через сервопривод)
//
// ВАЖНО: RELAY_INVERTED = false (реле ОБЫЧНОЕ)
// Это означает: HIGH (5В) на пине = реле ВКЛЮЧЕНО
//               LOW (0В) на пине = реле ВЫКЛЮЧЕНО
// =====================================================================

void controlSystems() {
  // millis() - возвращает количество миллисекунд с момента включения Arduino
  // currentTime - текущее "время" в миллисекундах (хранится в переменной)
  unsigned long currentTime = millis();


  // =====================================================================
  // 1. УПРАВЛЕНИЕ ПОЛИВОМ (НАСОС)
  // =====================================================================
  // ЛОГИКА РАБОТЫ:
  //
  // УСЛОВИЯ ДЛЯ ВКЛЮЧЕНИЯ НАСОСА (ДОЛЖНЫ ВЫПОЛНИТЬСЯ ВСЕ):
  //   1) Почва СУХАЯ: влажность < SOIL_DRY = 40%
  //   2) В баке ЕСТЬ вода: waterPresent = true
  //   3) Прошло 10 минут с последнего полива
  //
  // УСЛОВИЯ ДЛЯ ВЫКЛЮЧЕНИЯ НАСОСА (ДОСТАТОЧНО ЛЮБОГО):
  //   1) Прошло 2 секунды работы
  //   2) Почва стала ВЛАЖНОЙ: влажность > SOIL_WET = 70%
  //   3) Вода закончилась в баке
  //   4) Аварийный таймер: насос работает больше 30 секунд
  // =====================================================================

  // ----- ПРОВЕРКА: насос ВКЛЮЧЕН или ВЫКЛЮЧЕН? -----
  if (pumpState == true) {
    // ========== СЛУЧАЙ 1: НАСОС ВКЛЮЧЕН ==========
    // Проверяем условия для ВЫКЛЮЧЕНИЯ насоса
    
    // УСЛОВИЕ А: прошло больше PUMP_RUN_TIME (2 секунды) с момента включения?
    bool timeCondition = (currentTime - pumpStartTime > PUMP_RUN_TIME);
    
    // УСЛОВИЕ Б: влажность почвы достигла или превысила SOIL_WET (70%)?
    bool moistureCondition = (soilMoistureFiltered >= SOIL_WET);
    
    // УСЛОВИЕ В: вода закончилась в баке?
    bool noWaterCondition = (!waterPresent);
    
    // УСЛОВИЕ Г: аварийная защита (30 секунд)
    bool emergencyCondition = (currentTime - pumpStartTime > MAX_PUMP_RUN_TIME);
    
    // ПРОВЕРКА: если выполнено ЛЮБОЕ из условий → выключаем насос
    if (timeCondition || moistureCondition || noWaterCondition || emergencyCondition) {
      
      // --- ВЫКЛЮЧАЕМ НАСОС ---
      // RELAY_INVERTED = false, поэтому LOW (0В) = ВЫКЛЮЧЕНО
      digitalWrite(PUMP_PIN, LOW);
      
      // Меняем состояние насоса на ВЫКЛЮЧЕН
      pumpState = false;
      
      // ==== ЗАПОМИНАЕМ ВРЕМЯ ВЫКЛЮЧЕНИЯ ====
      // lastWatering хранит время последнего ОКОНЧАНИЯ полива
      // Используется для таймера "отдыха" между поливами
      // БЕЗ ЭТОЙ СТРОЧКИ насос будет включаться снова и снова!
      lastWatering = currentTime;
      
      // Логируем причину выключения
      if (timeCondition) {
        Serial.println("WATERING: Pump STOPPED - time elapsed (2 seconds)");
      }
      else if (moistureCondition) {
        Serial.println("WATERING: Pump STOPPED - soil is wet");
      }
      else if (noWaterCondition) {
        Serial.println("WATERING: Pump STOPPED - NO WATER in tank!");
        for (int i = 0; i < 3; i++) {
          digitalWrite(STATUS_LED, HIGH);
          delay(100);
          digitalWrite(STATUS_LED, LOW);
          delay(100);
        }
      }
      else if (emergencyCondition) {
        Serial.println("WATERING: Pump STOPPED - EMERGENCY (30 sec timeout)");
      }
    }
    
  } else {
    // ========== СЛУЧАЙ 2: НАСОС ВЫКЛЮЧЕН ==========
    // Проверяем условия для ВКЛЮЧЕНИЯ насоса
    
    // УСЛОВИЕ 1: почва СУХАЯ? (влажность < 40%)
    bool soilDryCondition = (soilMoistureFiltered < SOIL_DRY);
    
    // УСЛОВИЕ 2: в баке ЕСТЬ вода?
    bool waterPresentCondition = waterPresent;
    
    // УСЛОВИЕ 3: прошло больше 10 минут с последнего полива?
    bool cooldownCondition = (currentTime - lastWatering > WATERING_COOLDOWN);
    
    // ==== ВКЛЮЧАЕМ НАСОС ТОЛЬКО ЕСЛИ ВСЕ 3 УСЛОВИЯ ВЫПОЛНЕНЫ ====
    if (soilDryCondition && waterPresentCondition && cooldownCondition) {
      
      // --- ВКЛЮЧАЕМ НАСОС ---
      // RELAY_INVERTED = false, поэтому HIGH (5В) = ВКЛЮЧЕНО
      digitalWrite(PUMP_PIN, HIGH);
      
      // Меняем состояние насоса на ВКЛЮЧЕН
      pumpState = true;
      
      // ==== ЗАПОМИНАЕМ ВРЕМЯ ВКЛЮЧЕНИЯ ====
      // НУЖНО для контроля длительности работы (2 секунды)
      pumpStartTime = currentTime;
      
      // Также запоминаем время начала полива (для таймера отдыха)
      lastWatering = currentTime;
      
      Serial.print("WATERING: Pump STARTED (soil=");
      Serial.print(soilMoistureFiltered);
      Serial.println("% < 40%)");
      
      // Показываем сообщение на дисплее
      if (currentDisplayMode == DISPLAY_NORMAL) {
        lcd->clear();
        safePrint("WATERING", 0, 0);
        safePrint("ON", 0, 1);
        delay(500);
      }
    }
  }


  // ===== 2. УПРАВЛЕНИЕ ФИТОЛЕНТОЙ С ЗАЩИТОЙ ОТ ОБРАТНОЙ СВЯЗИ =====
  // Проблема: свет от лампы попадает на датчик и вызывает ложное выключение
  // Решение: после включения лампы игнорируем датчик 10 секунд
  
  // Статическая переменная хранит время последнего включения лампы
  static unsigned long lastLampTurnOnTime = 0;
  
  // Проверяем, нужно ли включать лампу (только если выключена)
  if (lightLevelFiltered < LIGHT_ON_THRESHOLD && lampState == false) {
    // Включаем лампу
    digitalWrite(LED_GROW_PIN, HIGH);
    lampState = true;
    lastLampTurnOnTime = millis();   // Запоминаем время включения
    Serial.print("LIGHTING: ON (light=");
    Serial.print(lightLevelFiltered);
    Serial.println("%)");
  }
  
  // Проверяем, нужно ли выключать лампу
  // НО: не выключаем, если прошло меньше 10 секунд после включения!
  else if (lampState == true) {
    // Сколько прошло с момента включения лампы
    unsigned long timeSinceTurnOn = millis() - lastLampTurnOnTime;
    
    // Если прошло больше 10 секунд И освещённость выше порога — выключаем
    if (timeSinceTurnOn > 10000 && lightLevelFiltered > LIGHT_OFF_THRESHOLD) {
      digitalWrite(LED_GROW_PIN, LOW);
      lampState = false;
      Serial.print("LIGHTING: OFF (light=");
      Serial.print(lightLevelFiltered);
      Serial.println("%)");
    }
    else if (timeSinceTurnOn <= 10000) {
      // Отладка: видно, что защита работает
      static unsigned long lastDebug = 0;
      if (millis() - lastDebug > 5000) {
        lastDebug = millis();
        Serial.print("LIGHTING: Protection active, ignoring sensor for ");
        Serial.print((10000 - timeSinceTurnOn) / 1000);
        Serial.println(" seconds");
      }
    }
  }
  
  
  // =====================================================================
  // 3. УПРАВЛЕНИЕ ВЕНТИЛЯЦИЕЙ (ФОРТОЧКА)
  // =====================================================================
  controlWindow(tempFiltered);
  
} // КОНЕЦ ФУНКЦИИ controlSystems()

// =====================================================================
// РАЗДЕЛ 15: ОБНОВЛЕНИЕ ИНФОРМАЦИИ НА ДИСПЛЕЕ (5 ЭКРАНОВ)
// =====================================================================

// Функция для обновления информации на дисплее
void updateDisplay() {
  // Если дисплей не в нормальном режиме - не обновляем
  if (currentDisplayMode != DISPLAY_NORMAL) {
    return;
  }
  
  // Проверяем здоровье дисплея
  if (!checkLCDHealth()) {
    // Если дисплей не отвечает - переходим в режим восстановления
    currentDisplayMode = DISPLAY_RECOVERING;
    return;
  }
  
  // Проверяем, прошло ли 3 секунды с последней смены экрана
  if (millis() - lastDisplayChange > DISPLAY_CHANGE_TIME) {
    // Переключаем экран на следующий (0→1→2→3→4→0...)
    displayScreen = (displayScreen + 1) % MAX_DISPLAY_SCREENS;
    lastDisplayChange = millis();
    
    // Очищаем экран печатью пробелов (более стабильно, чем lcd->clear())
    safePrint("                ", 0, 0);
    safePrint("                ", 0, 1);
  }
  
  // В зависимости от номера экрана показываем разную информацию
  switch(displayScreen) {
    
    case 0:  // ЭКРАН 0: ТЕМПЕРАТУРА И СОСТОЯНИЕ ФОРТОЧКИ
      safePrint("TEMP: ", 0, 0);
      
      if (isnan(tempFiltered)) {
        safePrint("Error", 6, 0);
      } else {
        char tempStr[10];
        dtostrf(tempFiltered, 5, 1, tempStr);  // float в строку
        safePrint(tempStr, 6, 0);
        lcd->write(223);  // Символ градуса ° (ASCII код 223)
        safePrint("C", 12, 0);
      }
      
      if (tempFiltered >= OPEN_TEMP) {
        safePrint("WINDOW: OPEN", 0, 1);
      } else if (tempFiltered <= CLOSE_TEMP) {
        safePrint("WINDOW: CLOSED", 0, 1);
      } else {
        safePrint("WINDOW: OK", 0, 1);
      }
      break;
      
    case 1:  // ЭКРАН 1: ВЛАЖНОСТЬ ВОЗДУХА
      safePrint("AIR HUM: ", 0, 0);
      
      if (isnan(humidityFiltered)) {
        safePrint("Error", 9, 0);
      } else {
        char humStr[10];
        dtostrf(humidityFiltered, 5, 0, humStr);
        safePrint(humStr, 9, 0);
        safePrint("%", 14, 0);
      }
      
      if (humidityFiltered >= 80) {
        safePrint("STATUS: HUMID", 0, 1);
      } else if (humidityFiltered >= 60) {
        safePrint("STATUS: NORMAL", 0, 1);
      } else if (humidityFiltered >= 40) {
        safePrint("STATUS: DRY", 0, 1);
      } else {
        safePrint("STATUS: VERY DRY", 0, 1);
      }
      break;
      
    case 2:  // ЭКРАН 2: ОСВЕЩЁННОСТЬ И ФИТОЛЕНТА
      safePrint("LIGHT: ", 0, 0);
      
      char lightStr[10];
      itoa(lightLevelFiltered, lightStr, 10);
      safePrint(lightStr, 7, 0);
      safePrint("%", 10, 0);
      
      safePrint("GROW LIGHT: ", 0, 1);
      safePrint(lampState ? "ON" : "OFF", 12, 1);
      break;
      
    case 3:  // ЭКРАН 3: ВЛАЖНОСТЬ ПОЧВЫ И НАСОС
      safePrint("SOIL: ", 0, 0);
      
      char soilStr[10];
      itoa(soilMoistureFiltered, soilStr, 10);
      safePrint(soilStr, 6, 0);
      safePrint("%", 9, 0);
      
      safePrint("WATER PUMP: ", 0, 1);
      safePrint(pumpState ? "ON" : "OFF", 12, 1);
      break;
      
    case 4:  // ЭКРАН 4: УРОВЕНЬ ВОДЫ В БАКЕ
      safePrint("WATER: ", 0, 0);
      
      if (waterPresent) {
        safePrint("FULL", 7, 0);
      } else {
        safePrint("EMPTY", 7, 0);
      }
      
      safePrint("                ", 0, 1);
      
      if (!waterPresent) {
        safePrint("REFILL WATER!", 0, 1);
      } else if (soilMoistureFiltered < SOIL_DRY) {
        safePrint("READY TO WATER", 0, 1);
      } else {
        safePrint("SYSTEM OK", 0, 1);
      }
      break;
  }
  
  // Обновляем время последней успешной работы дисплея
  lastDisplaySuccess = millis();
}


// =====================================================================
// РАЗДЕЛ 16: ОТЛАДОЧНЫЙ ВЫВОД В СЕРИАЛЬНЫЙ МОНИТОР
// =====================================================================

// Функция для отладочного вывода в Serial монитор
void debugOutput() {
  // Статическая переменная для хранения времени последнего вывода
  static unsigned long lastDebug = 0;
  
  // Проверяем, прошло ли 5 секунд (5000 мс)
  if (millis() - lastDebug > 5000) {
    lastDebug = millis();
    
    Serial.println("\n=== GREENHOUSE STATUS REPORT ===");
    Serial.print("Temperature: "); Serial.print(tempFiltered); Serial.println(" °C");
    Serial.print("Air humidity: "); Serial.print(humidityFiltered); Serial.println(" %");
    Serial.print("Light level: "); Serial.print(lightLevelFiltered); Serial.println(" %");
    Serial.print("Soil moisture: "); Serial.print(soilMoistureFiltered); Serial.println(" %");
    Serial.print("Water tank: "); Serial.println(waterPresent ? "FULL" : "EMPTY");
    
    Serial.print("Devices: ");
    Serial.print("Grow light "); Serial.print(lampState ? "ON" : "OFF");
    Serial.print(", Water pump "); Serial.print(pumpState ? "ON" : "OFF");
    Serial.print(", Window "); Serial.println(windowIsOpen ? "OPEN" : "CLOSED");
    
    Serial.print("Relay logic: ");
    Serial.println(RELAY_INVERTED ? "INVERTED (LOW=ON)" : "NORMAL (HIGH=ON)");
    
    Serial.print("Display mode: ");
    if (currentDisplayMode == DISPLAY_NORMAL) {
      Serial.print("NORMAL, ");
      Serial.print(displayRecoveryAttempts);
      Serial.println(" recovery attempts");
    } else if (currentDisplayMode == DISPLAY_RECOVERING) {
      Serial.println("RECOVERING");
    } else {
      Serial.println("DISCONNECTED");
    }
    
    Serial.println("==================================\n");
  }
}


// =====================================================================
// РАЗДЕЛ 17: ГЛАВНЫЙ ЦИКЛ ПРОГРАММЫ (LOOP)
// =====================================================================

void loop() {
  
  // ----- ШАГ 1: УПРАВЛЕНИЕ СОСТОЯНИЕМ ДИСПЛЕЯ -----
  if (currentDisplayMode != DISPLAY_NORMAL) {
    // Если дисплей не в нормальном режиме - пытаемся восстановить
    attemptDisplayRecovery();
  } else {
    // Если в нормальном режиме - проверяем здоровье дисплея
    if (!checkLCDHealth()) {
      currentDisplayMode = DISPLAY_RECOVERING;
    }
  }
  
  // ----- ШАГ 2: ЧТЕНИЕ ВСЕХ ДАТЧИКОВ -----
  readSensors();
  
  // ----- ШАГ 3: УПРАВЛЕНИЕ ВСЕМИ СИСТЕМАМИ -----
  controlSystems();
  
  // ----- ШАГ 4: ОБНОВЛЕНИЕ ДИСПЛЕЯ -----
  updateDisplay();
  
  // ----- ШАГ 5: ОТЛАДОЧНЫЙ ВЫВОД -----
  debugOutput();
  
  // ----- ШАГ 6: АВТОМАТИЧЕСКИЙ РЕСЕТ ДИСПЛЕЯ -----
  #if SUPER_PROTECTION
  static unsigned long lastAutoResetCheck = millis();
  
  if (millis() - lastAutoResetCheck > 30000) {
    lastAutoResetCheck = millis();
    
    // Если дисплей не обновлялся 25 секунд - принудительный сброс
    if (millis() - lastDisplaySuccess > 25000) {
      Serial.println("Auto-reset: Display not updated for 25+ seconds");
      
      if (lcd != NULL) {
        lcd->noBacklight();
        delay(100);
        lcd->backlight();
        delay(100);
      }
      
      currentDisplayMode = DISPLAY_RECOVERING;
      displayRecoveryAttempts = 0;
    }
  }
  #endif
  
  // ----- ШАГ 7: ПАУЗА ДЛЯ СТАБИЛЬНОЙ РАБОТЫ -----
  delay(100);
}


