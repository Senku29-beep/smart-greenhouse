

```cpp
/*
  ======================================================================
  УМНАЯ ТЕПЛИЦА - ПОЛНАЯ ВЕРСИЯ С СИСТЕМОЙ ВОССТАНОВЛЕНИЯ ДИСПЛЕЯ
  ======================================================================
  
  ВСЕ ФУНКЦИИ И ФИШКИ СОХРАНЕНЫ:
  - Автоматическое восстановление дисплея (3 метода)
  - Фильтрация показаний датчиков
  - Гистерезис для фитоленты и форточки
  - Импульсное питание датчика воды (предотвращает электролиз)
  - Защита от зависания DHT11
  - Управление поливом, светом, вентиляцией
  - 5 экранов на дисплее
  - Отключение любых датчиков макросами
  - Настройка инвертированных реле и датчиков
*/

// =====================================================================
// РАЗДЕЛ 1: ПОДКЛЮЧЕНИЕ ВНЕШНИХ БИБЛИОТЕК
// =====================================================================

// Библиотека Wire - для работы с шиной I2C (медленная двунаправленная шина)
// I2C использует два провода: SDA (данные) и SCL (синхронизация)
// На Arduino Uno: SDA на пине A4, SCL на пине A5
// Подробнее: библиотека содержит функции begin(), beginTransmission(), endTransmission(), requestFrom()
#include <Wire.h>

// Библиотека для LCD дисплея с I2C интерфейсом
// Позволяет управлять дисплеем 16x2 всего по 2 проводам (вместо 6-8)
// Содержит функции: init(), clear(), setCursor(), print(), backlight(), noBacklight()
#include <LiquidCrystal_I2C.h>

// Библиотека для датчика температуры и влажности DHT11 (или DHT22)
// Содержит функции: begin(), readTemperature(), readHumidity()
// Внутри библиотеки реализована временная диаграмма опроса датчика (сигналы HIGH/LOW)
#include <DHT.h>

// Библиотека для управления сервоприводом (маленький мотор с обратной связью)
// Сервопривод получает сигнал ШИМ (PWM) - широтно-импульсную модуляцию
// Длительность импульса 1.5 мс = 0°, 1.5 мс = 90°, 2.5 мс = 180°
#include <Servo.h>

// БИБЛИОТЕКА ДЛЯ АППАРАТНОГО WATCHDOG (AVR)
// Watchdog — это встроенный в микроконтроллер таймер, который работает независимо от программы
// Если программа зависла и перестала его сбрасывать, watchdog через заданное время
// автоматически перезагружает микроконтроллер (Arduino перезапускается)
// Это называется "автоматическое восстановление после сбоя" (self-healing system)
// ПОДРОБНЕЕ: библиотека avr/wdt.h содержит функции wdt_enable(), wdt_reset(), wdt_disable()
#include <avr/wdt.h>


// =====================================================================
// РАЗДЕЛ 2: УМНАЯ СИСТЕМА ЗАЩИТЫ ДИСПЛЕЯ (УКАЗАТЕЛИ)
// =====================================================================

// LiquidCrystal_I2C* lcd = NULL - создаём УКАЗАТЕЛЬ на объект дисплея
// Указатель - это переменная, которая хранит адрес другого объекта в памяти
// NULL означает "ничего не указывает" - объект ещё не создан
// Это нужно для восстановления дисплея: мы можем удалить старый объект и создать новый
// Без указателя пришлось бы перезагружать всю плату Arduino
LiquidCrystal_I2C* lcd = NULL;

// uint8_t lcdAddress = 0 - переменная для хранения адреса дисплея на шине I2C
// uint8_t - беззнаковое 8-битное число (0-255)
// 0 означает "адрес ещё не найден"
// Адрес нужен чтобы обратиться именно к дисплею, а не к другому I2C-устройству
uint8_t lcdAddress = 0;

// const uint8_t POSSIBLE_LCD_ADDRESSES[] = {0x27, 0x3F} - массив возможных адресов дисплея
// const - константа, значение нельзя изменить
// uint8_t - тип элементов массива (0-255)
// [] - квадратные скобки означают "массив"
// {0x27, 0x3F} - инициализация массива значениями в шестнадцатеричной системе
// Большинство дисплеев имеют адрес 0x27 или 0x3F
const uint8_t POSSIBLE_LCD_ADDRESSES[] = {0x27, 0x3F};

// const int NUM_POSSIBLE_ADDRESSES = 2 - количество возможных адресов
// sizeof(POSSIBLE_LCD_ADDRESSES) / sizeof(POSSIBLE_LCD_ADDRESSES[0]) - вычислило бы 2 автоматически
// но для ясности пишем 2 (в массиве выше два адреса)
const int NUM_POSSIBLE_ADDRESSES = 2;


// =====================================================================
// РАЗДЕЛ 3: СИСТЕМА ВОССТАНОВЛЕНИЯ ДИСПЛЕЯ (enum и флаги)
// =====================================================================

// #define SUPER_PROTECTION true - определяем макрос для включения/выключения супер-защиты
// Макрос - текстовая замена перед компиляцией
// true = защита ВКЛЮЧЕНА, false = защита ВЫКЛЮЧЕНА
// #if SUPER_PROTECTION ... #else ... #endif - условная компиляция
#define SUPER_PROTECTION true

// enum DisplayMode - перечисление для состояний дисплея
// enum - пользовательский тип данных, который может принимать одно из перечисленных значений
// Внутри компилятор присваивает значения: DISPLAY_NORMAL = 0, DISPLAY_RECOVERING = 1, DISPLAY_DISCONNECTED = 2
// Это удобнее, чем использовать числа 0, 1, 2 - код становится самодокументируемым
enum DisplayMode {
  DISPLAY_NORMAL,      // Значение 0: дисплей работает нормально
  DISPLAY_RECOVERING,  // Значение 1: пытаемся восстановить дисплей
  DISPLAY_DISCONNECTED // Значение 2: дисплей отключен (сдались после 10 попыток)
};

// DisplayMode currentDisplayMode = DISPLAY_RECOVERING - создаём переменную для текущего состояния
// Изначально устанавливаем в DISPLAY_RECOVERING, потому что при запуске нужно сначала найти дисплей
// Это состояние означает "дисплей ещё не найден, пробуем восстановить"
DisplayMode currentDisplayMode = DISPLAY_RECOVERING;

// int displayRecoveryAttempts = 0 - счётчик попыток восстановления дисплея
// int - целое число (может быть отрицательным)
// Начальное значение = 0 (ещё не пытались)
int displayRecoveryAttempts = 0;

// const int MAX_RECOVERY_ATTEMPTS = 10 - максимальное количество попыток восстановления
// const - константа, значение нельзя изменить
// Если после 10 попыток не получилось - сдаёмся и переходим в DISPLAY_DISCONNECTED
const int MAX_RECOVERY_ATTEMPTS = 10;

// unsigned long lastRecoveryAttempt = 0 - время последней попытки восстановления
// unsigned long - 32-битное беззнаковое целое (0 до 4,294,967,295)
// Вмещает время до 49 дней в миллисекундах (millis())
// Используется для ограничения частоты попыток (не чаще 1 раза в 5 секунд)
unsigned long lastRecoveryAttempt = 0;

// const unsigned long RECOVERY_INTERVAL = 5000 - интервал между попытками восстановления
// 5000 миллисекунд = 5 секунд
// Не пытаемся восстанавливать слишком часто (это может вызвать дребезг)
const unsigned long RECOVERY_INTERVAL = 5000;

// unsigned long lastDisplaySuccess = 0 - время последней успешной работы дисплея
// Обновляется при каждой успешной операции с дисплеем (очистка, печать, установка курсора)
// Если 25 секунд не было успешных операций - инициируем восстановление
unsigned long lastDisplaySuccess = 0;

// bool forceDisplayReset = false - флаг для принудительного сброса дисплея
// bool - логический тип (true/false)
// true = нужно сделать принудительный сброс, false = не нужно
// Используется для внешнего принудительного восстановления (например, по команде с кнопки)
bool forceDisplayReset = false;


// =====================================================================
// РАЗДЕЛ 4: КОНФИГУРАЦИЯ ДАТЧИКОВ (ВКЛЮЧЕНИЕ/ОТКЛЮЧЕНИЕ МАКРОСАМИ)
// =====================================================================

// #define ENABLE_DHT true - макрос для включения/выключения датчика DHT11
// true = датчик подключен и работает
// false = датчик отключен (будут использоваться тестовые значения)
// Условная компиляция #if ENABLE_DHT ... #endif - код датчика не попадает в прошивку при false
#define ENABLE_DHT true

// #define ENABLE_SOIL true - макрос для включения/выключения датчика влажности почвы
// При false код опроса датчика не компилируется, soilMoistureFiltered = 50 (тестовое значение)
#define ENABLE_SOIL true

// #define ENABLE_LIGHT true - макрос для включения/выключения датчика освещённости (фоторезистор)
#define ENABLE_LIGHT true

// #define ENABLE_WATER false - макрос для включения/выключения датчика уровня воды
// СЕЙЧАС false - датчик отключен (waterPresent всегда true)
// Если подключите датчик воды, поставьте true
#define ENABLE_WATER true


// =====================================================================
// РАЗДЕЛ 5: ПОДКЛЮЧЕНИЕ УСТРОЙСТВ К ПИНАМ ARDUINO
// =====================================================================

// ----- ДАТЧИКИ (устройства ВВОДА - Arduino ЧИТАЕТ данные) -----

// #define DHT_PIN 2 - пин для подключения датчика DHT11
// DHT11 подключается к ЦИФРОВОМУ пину 2
// Цифровой пин может читать только HIGH (1) или LOW (0)
// Датчик передаёт данные последовательностью HIGH/LOW сигналов определённой длины
#define DHT_PIN 2

// #define DHTTYPE DHT11 - тип датчика (DHT11 или DHT22)
// DHT11 дешевле и медленнее (опрашивать раз в 2 секунды)
// DHT22 дороже, точнее и быстрее (опрашивать раз в 1 секунду)
#define DHTTYPE DHT11

// #define SOIL_MOISTURE_PIN A0 - пин для датчика влажности почвы
// Аналоговый пин A0 может измерять напряжение от 0 до 5В
// analogRead() возвращает 0-1023 (0В = 0, 5В = 1023)
#define SOIL_MOISTURE_PIN A0

// #define LIGHT_SENSOR_PIN A1 - пин для датчика освещённости (фоторезистор)
#define LIGHT_SENSOR_PIN A1

// #define WATER_SENSOR_PIN 6 - пин для сигнала датчика воды HCW-M203
// HCW-M203 - бинарный датчик (HIGH = вода есть, LOW = воды нет)
#define WATER_SENSOR_PIN 6

// #define WATER_SENSOR_RELAY_PIN 8 - пин для управления реле датчика воды
// Через это реле подаётся 12В на датчик воды
// Включаем питание только на 50 мс при измерении (импульсное питание)
// Это предотвращает электролиз медных проводов
#define WATER_SENSOR_RELAY_PIN 8

// ----- ИСПОЛНИТЕЛЬНЫЕ УСТРОЙСТВА (устройства ВЫВОДА - Arduino УПРАВЛЯЕТ) -----

// #define PUMP_PIN 3 - пин для управления насосом (через реле)
// Насос 12В, подключается через реле, реле управляется сигналом с Arduino
#define PUMP_PIN 3

// #define SERVO_PIN 4 - пин для управления сервоприводом (форточка)
// Сервопривод имеет 3 провода: питание (красный), земля (коричневый), сигнал (оранжевый)
#define SERVO_PIN 4

// #define LED_GROW_PIN 5 - пин для управления фитолентой (через реле)
// Фитолента 12В, подключается через реле
#define LED_GROW_PIN 5

// #define STATUS_LED 13 - пин для встроенного светодиода на плате Arduino
// Это физический светодиод рядом с пином 13 (можно увидеть на плате)
// Используется для визуальной индикации состояния системы
#define STATUS_LED 13


// =====================================================================
// РАЗДЕЛ 6: СОЗДАНИЕ ОБЪЕКТОВ ДЛЯ УПРАВЛЕНИЯ УСТРОЙСТВАМИ
// =====================================================================

// DHT dht(DHT_PIN, DHT11) - создаём объект для датчика DHT11
// Объект - это экземпляр класса, который содержит данные и методы для работы с датчиком
// Конструктор принимает номер пина и тип датчика
// После создания объекта можно вызывать методы: dht.begin(), dht.readTemperature(), dht.readHumidity()
DHT dht(DHT_PIN, DHT11);

// Servo ventServo - создаём объект для сервопривода с именем "ventServo"
// Пока не привязан к конкретному пину (привязка будет в setup() через ventServo.attach(SERVO_PIN))
Servo ventServo;


// =====================================================================
// РАЗДЕЛ 7: НАСТРОЙКИ СИСТЕМЫ (ПОРОГОВЫЕ ЗНАЧЕНИЯ И КАЛИБРОВКА)
// =====================================================================

// ----- ВРЕМЯ РАБОТЫ УСТРОЙСТВ (в миллисекундах) -----
// const unsigned long PUMP_RUN_TIME = 5000 - насос работает 5 секунд за один полив
// 5000 миллисекунд = 5 секунд
// Это время достаточно, чтобы почва пропиталась водой
const unsigned long PUMP_RUN_TIME = 2000;

// const unsigned long WATERING_COOLDOWN = 600000 - задержка между поливами
// 600000 мс = 600 секунд = 10 минут
// Даже если почва всё ещё сухая, насос не включится раньше чем через 10 минут
// Это предотвращает заливание растений и защищает насос от перегрева
const unsigned long WATERING_COOLDOWN = 600000;

// ----- ВЛАЖНОСТЬ ПОЧВЫ (в процентах) -----
// const int SOIL_DRY = 40 - порог СУХОЙ почвы (нужен полив)
// Если влажность < 40%, включаем полив
const int SOIL_DRY = 40;

// const int SOIL_WET = 70 - порог ВЛАЖНОЙ почвы (хватит поливать)
// Если влажность > 70%, выключаем полив
// Разница между SOIL_DRY и SOIL_WET (30%) - это ГИСТЕРЕЗИС
// Предотвращает частое включение/выключение насоса
const int SOIL_WET = 70;

// ----- ТЕМПЕРАТУРА ВОЗДУХА (в градусах Цельсия) -----
// const float OPEN_TEMP = 28.0 - температура ОТКРЫТИЯ форточки
// float - число с плавающей точкой (дробное)
// Если температура > 28.0°C, открываем форточку
const float OPEN_TEMP = 28.0;

// const float CLOSE_TEMP = 26.0 - температура ЗАКРЫТИЯ форточки
// Если температура < 26.0°C, закрываем форточку
// Разница 2 градуса - гистерезис, предотвращает дребезг форточки
const float CLOSE_TEMP = 26.0;

// ---------------------------------------------------------------------
// 4. ОСВЕЩЁННОСТЬ (в процентах)
// ---------------------------------------------------------------------
// ВНИМАНИЕ: Ваш датчик освещённости (фоторезистор) работает ИНВЕРТИРОВАННО:
//   - В ТЕМНОТЕ (рукой накрыли) → analogRead() возвращает БОЛЬШОЕ число (около 675) → 0%
//   - НА СВЕТУ (фонарик) → analogRead() возвращает МАЛЕНЬКОЕ число (около 0) → 100%
//
// Поэтому пороги срабатывания НАОБОРОТ по сравнению со стандартной логикой:
//   - Включаем фитоленту, когда освещённость ВЫСОКАЯ (>80%) — это означает, что на самом деле ТЕМНО
//   - Выключаем фитоленту, когда освещённость НИЗКАЯ (<20%) — это означает, что на самом деле СВЕТЛО
// =====================================================================

// const int DARK_THRESHOLD = 80 - порог ВКЛЮЧЕНИЯ фитоленты (когда на датчике "темно")
// Если освещённость > 80% (датчик показывает высокий процент), значит в реальности ТЕМНО → включаем фитоленту
const int DARK_THRESHOLD = 80;

// const int LIGHT_THRESHOLD = 20 - порог ВЫКЛЮЧЕНИЯ фитоленты (когда на датчике "светло")
// Если освещённость < 20% (датчик показывает низкий процент), значит в реальности СВЕТЛО → выключаем фитоленту
const int LIGHT_THRESHOLD = 20;

// Разница между DARK_THRESHOLD (80%) и LIGHT_THRESHOLD (20%) = 60% - это ГИСТЕРЕЗИС
// Предотвращает частое включение/выключение фитоленты при колебаниях освещённости
// Физический смысл:
//   - Фитолента включается, когда реальная освещённость падает ниже ~20% (темно)
//   - Фитолента выключается, когда реальная освещённость поднимается выше ~80% (светло)
//   - В промежутке от 20% до 80% состояние лампы НЕ МЕНЯЕТСЯ

// ----- НАСТРОЙКИ УГЛОВ СЕРВОПРИВОДА (в градусах) -----
// const int SERVO_CLOSED = 0 - угол ЗАКРЫТОЙ форточки
// 0° = форточка полностью закрыта
const int SERVO_CLOSED = 0;

// const int SERVO_OPEN = 90 - угол ОТКРЫТОЙ форточки
// 90° = форточка полностью открыта
// Если ваша форточка открывается на 120°, увеличьте это значение
const int SERVO_OPEN = 90;

// ----- НАСТРОЙКА ТИПА РЕЛЕ (LOW включает или HIGH включает) -----
// const bool RELAY_INVERTED = true - реле ИНВЕРТИРОВАННОЕ
// Большинство релейных модулей для Arduino сделаны так:
//   - LOW (0В) на пине → реле ВКЛЮЧАЕТСЯ (замыкает контакты COM и NO)
//   - HIGH (5В) на пине → реле ВЫКЛЮЧАЕТСЯ (размыкает контакты)
// Поэтому RELAY_INVERTED = true
const bool RELAY_INVERTED = false;

// ----- КАЛИБРОВКА ДАТЧИКА ВЛАЖНОСТИ ПОЧВЫ -----
// const int SOIL_DRY_CALIB = 554 - значение датчика в СУХОЙ почве
// Это число вы получили экспериментом (сухая земля → analogRead() = 554)
// Соответствует 0% влажности
const int SOIL_DRY_CALIB = 554;

// const int SOIL_WET_CALIB = 233 - значение датчика в МОКРОЙ почве
// Соответствует 100% влажности
const int SOIL_WET_CALIB = 233;

// ----- КАЛИБРОВКА ДАТЧИКА ОСВЕЩЁННОСТИ -----
// const int DARK_VALUE = 0 - значение в полной темноте
// Фоторезистор имеет максимальное сопротивление → напряжение близко к 0
const int DARK_VALUE = 0;

// const int BRIGHT_VALUE = 675 - значение при ярком свете
// Измерено вами (фонарик на датчик → analogRead() = 675)
const int BRIGHT_VALUE = 675;

// ----- НАСТРОЙКА БИНАРНОГО ДАТЧИКА ВОДЫ HCW-M203 -----
// const bool WATER_SENSOR_INVERTED = true - настройка инверсии
// Ваш датчик HCW-M203 выдаёт:
//   - HIGH (1) когда датчик в воде
//   - LOW (0) когда датчик в воздухе
// Поэтому WATER_SENSOR_INVERTED = true (HIGH = вода есть)
// Если датчик работает наоборот, поменяйте на false
const bool WATER_SENSOR_INVERTED = true;

// ----- НАСТРОЙКИ БЕЗОПАСНОСТИ НАСОСА -----
// const unsigned long MAX_PUMP_RUN_TIME = 30000 - максимальное время работы насоса
// 30000 миллисекунд = 30 секунд
const unsigned long MAX_PUMP_RUN_TIME = 30000;

// const unsigned long MIN_PUMP_OFF_TIME = 60000 - минимальное время простоя насоса
// 60000 миллисекунд = 60 секунд = 1 минута
const unsigned long MIN_PUMP_OFF_TIME = 60000;   // ← ТОЛЬКО ОДИН РАЗ!

// =====================================================================
// РАЗДЕЛ 8: ПЕРЕМЕННЫЕ ДЛЯ ХРАНЕНИЯ ДАННЫХ
// =====================================================================

// ----- ОТФИЛЬТРОВАННЫЕ ЗНАЧЕНИЯ ДАТЧИКОВ -----
// float tempFiltered = 25.0 - отфильтрованная температура
